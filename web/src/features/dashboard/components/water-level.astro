<style>
  .water-container {
    position: relative;
    width: 200px;
    aspect-ratio: 1;
  }

  .water-container svg {
    width: 100%;
    height: 100%;
  }

  #water-fill {
    transition:
      y 1s ease,
      height 1s ease;
    background-color: red;
  }

  .water-label {
    position: absolute;
    inset: 0;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    pointer-events: none;
  }

  .water-percentage {
    position: relative;
    display: grid;
    place-items: center;
  }

  .water-percentage strong {
    grid-area: 1 / 1;
    font-size: 2rem;
    line-height: 1;
  }

  #percentage-dark {
    color: var(--color-primary);
    clip-path: inset(0 0 0 0);
  }

  #percentage-light {
    color: rgb(255, 255, 255);
    clip-path: inset(100% 0 0 0);
    font: bold;
  }

  .water-label span {
    font-size: 0.8rem;
    color: var(--color-primary);
    font: bold;
  }
</style>

<div class="water-container">
  <svg viewBox="0 0 200 200">
    <defs>
      <clipPath id="circle-clip">
        <circle cx="100" cy="100" r="90" />
      </clipPath>

      <linearGradient
        id="water-gradient"
        x1="0"
        y1="1"
        x2="0"
        y2="0"
      >
        <stop offset="0%" stop-color="var(--primary)" />
        <stop offset="65%" stop-color="#3b82f6" />
        <stop offset="100%" stop-color="#87a8f5" />
      </linearGradient>
    </defs>

    <circle
      cx="100"
      cy="100"
      r="90"
      fill="#e2e8f0"
    />

    <g clip-path="url(#circle-clip)">
      <rect
        id="water-fill"
        x="10"
        y="100"
        width="180"
        height="90"
        fill="url(#water-gradient)"
      />
    </g>

    <circle
      cx="100"
      cy="100"
      r="90"
      fill="none"
      stroke="var(--color-border)"
      stroke-width="3"
    />
  </svg>

  <div class="water-label">
    <div class="water-percentage">
      <strong id="percentage-dark">0%</strong>
      <strong id="percentage-light">0%</strong>
    </div>

  </div>
</div>

<script>
  const waterFill =
    document.querySelector<SVGRectElement>("#water-fill")!;

  const percentageDark =
    document.querySelector<HTMLElement>("#percentage-dark")!;

  const percentageLight =
    document.querySelector<HTMLElement>("#percentage-light")!;

  function updateWaterLevel(value: number) {
    const percentage = Math.min(100, Math.max(0, value));

    const maxHeight = 180;
    const height = maxHeight * (percentage / 100);
    const y = 190 - height;

    waterFill.setAttribute("y", String(y));
    waterFill.setAttribute("height", String(height));

    const label = `${percentage}%`;

    percentageDark.textContent = label;
    percentageLight.textContent = label;

    const svg = waterFill.ownerSVGElement!;

    const svgRect = svg.getBoundingClientRect();
    const textRect = percentageDark.getBoundingClientRect();

    const waterSurface =
      svgRect.top + (y / 200) * svgRect.height;

    const waterPosition = Math.max(
      0,
      Math.min(
        100,
        ((waterSurface - textRect.top) / textRect.height) * 100
      )
    );

    percentageLight.style.clipPath =
      `inset(${waterPosition}% 0 0 0)`;

    percentageDark.style.clipPath =
      `inset(0 0 ${100 - waterPosition}% 0)`;
  }

  updateWaterLevel(100);
</script>