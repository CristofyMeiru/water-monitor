---
import Item from "@/features/ui-components/item.astro"; 
import IconBatteryVertical from '@/assets/battery-vertical.svg'
import IconDroplet from '@/assets/droplet.svg'

const itemMediaStyle = " bg-primary/80 text-white rounded-sm p-1"
const itemTitleStyle = " text-2xl font-bold "
const itemDescriptionStyle = " font-semibold "
const itemIconStyle = " size-8 "

---

<div class="flex flex-col  space-y-2 ">
   
    <Item  part="group">
         <Item variant="outline" class={"w-full"}>
        <Item part="media" class={itemMediaStyle}><IconBatteryVertical class={itemIconStyle}/></Item>
        <Item part="content">
            <Item part="description" class={itemDescriptionStyle}>Capacidade total</Item>
            <Item part="title" class={itemTitleStyle}>2.000 L</Item>
        </Item>
    </Item>
    <Item variant="outline" class={"w-full"}>
        <Item part="media" class={itemMediaStyle}><IconDroplet class={itemIconStyle}/></Item>
        <Item part="content">
            <Item part="description" class={itemDescriptionStyle}>Água disponível</Item>
            <Item part="title" class={itemTitleStyle}>1.000 L</Item>
        </Item>
    </Item>
    </Item>
</div>