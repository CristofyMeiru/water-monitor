---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

type Parts =
  | "header"
  | "title"
  | "description"
  | "action"
  | "content"
  | "footer";

type Props = HTMLAttributes<"div"> &
  (
    | {
        part?: "root";
        as?: "div" | "section" | "article" | "li" | "a";
        href?: string;
      }
    | { part: Parts }
  );

const styles: Record<"root" | Parts, string> = {
  root: "bg-card text-card-foreground flex flex-col gap-6 rounded-none border py-6 shadow-sm",
  header:
    "@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-1.5 px-6 has-data-[slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6",
  title: "leading-none font-semibold",
  description: "text-muted-foreground text-sm",
  action: "col-start-2 row-span-2 row-start-1 self-start justify-self-end",
  content: "px-6",
  footer: "flex items-center px-6 [.border-t]:pt-6",
};

const {
  part = "root",
  as,
  class: className,
  ...rest
} = Astro.props as Record<string, any>;

const Tag = part === "root" ? (as ?? "div") : "div";
---

<Tag
  data-slot={part === "root" ? "card" : `card-${part}`}
  class={cn(styles[part as "root" | Parts], className)}
  {...rest}
>
  <slot />
</Tag>