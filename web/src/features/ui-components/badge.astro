---
import type { HTMLAttributes } from "astro/types";

const variants = {
  green: "border-success/25 bg-success/10 text-success",
  red: "border-destructive/25 bg-destructive/10 text-destructive",
  yellow: "border-warning/25 bg-warning/10 text-warning",
  gray: "border-border bg-muted text-muted-foreground",
} as const;

export interface Props extends HTMLAttributes<"span"> {
  variant?: keyof typeof variants;
}

const { variant = "gray", class: className, ...rest } = Astro.props;
---

<span
  data-slot="badge"
  class:list={[
    "inline-flex w-fit shrink-0 items-center justify-center gap-1 whitespace-nowrap rounded-md border px-2 py-0.5 text-xs font-medium [&>svg]:size-3 [&>svg]:pointer-events-none",
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</span>